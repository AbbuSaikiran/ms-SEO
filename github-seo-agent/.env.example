# GitHub fine-grained PAT (with 'Contents' and 'Pull requests' read/write access)
GITHUB_TOKEN=github_pat_xxx

# AI LLM Provider Key (Claude Sonnet 3.5/Sonnet, Groq, or OpenAI)
ANTHROPIC_API_KEY=sk-ant-xxx
GROQ_API_KEY=gsk_xxx
OPENAI_API_KEY=sk-proj-xxx

# Target Repository Details
OWNER=your-user
REPO=your-repo
SITE_URL=https://example.com
BASE_BRANCH=main

# Hindsight Cloud Memory (Vectorize.io)
VECTORIZE_API_KEY=hsk_xxx
VECTORIZE_API_ENDPOINT=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=seo-agent-bank

# Set to 1 to run dry-run without pushing or opening PR
DRY_RUN=
